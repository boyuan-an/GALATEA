+def _sample_solid_rgb(image_path, mask_path):
+    image_bgr = cv2.imread(image_path, cv2.IMREAD_COLOR)
+    mask = cv2.imread(mask_path, cv2.IMREAD_UNCHANGED)
+    if image_bgr is None:
+        raise FileNotFoundError(f"Could not read solid-color image: {image_path}")
+    if mask is None:
+        raise FileNotFoundError(f"Could not read solid-color mask: {mask_path}")
+    if mask.ndim == 3:
+        mask = np.any(mask > 0, axis=2)
+    else:
+        mask = mask > 0
+    image_rgb = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2RGB)
+    if image_rgb.shape[:2] != mask.shape:
+        image_rgb = cv2.resize(
+            image_rgb, (mask.shape[1], mask.shape[0]),
+            interpolation=cv2.INTER_LINEAR,
+        )
+    pixels = image_rgb[mask]
+    if not len(pixels):
+        raise ValueError(f"Empty object mask, cannot sample solid color: {mask_path}")
+    rgb_u8 = np.median(pixels, axis=0).astype(np.uint8)
+    return tuple(float(value) / 255.0 for value in rgb_u8), tuple(int(value) for value in rgb_u8)
+
